# Keamanan Direktori Uploads
# Menolak seluruh eksekusi script server-side dalam direktori penyimpanan statis
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|inc|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
